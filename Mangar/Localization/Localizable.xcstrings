    "默认 B5 内容置于 A4 稿纸：左右各 14 mm，上下各 20 mm。出血参考框距内容框 3 mm。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default: B5 content on A4 paper, with 14 mm side margins and 20 mm top/bottom margins. The bleed guide is 3 mm outside the content frame."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定はA4原稿用紙にB5の内容枠。左右14 mm、上下20 mmの余白で、裁ち落とし枠は内容枠の外側3 mmです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认 B5 内容置于 A4 稿纸：左右各 14 mm，上下各 20 mm。出血参考框距内容框 3 mm。"
          }
        }
      }
    },
